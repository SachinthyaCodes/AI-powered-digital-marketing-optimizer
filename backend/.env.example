# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/
DATABASE_NAME=marketmatic

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Configuration (for Password Reset)
# Option 1: Gmail (Free - up to 500 emails/day)
# Steps to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Factor Authentication
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Generate an app password for "Mail"
# 5. Use that 16-character password below (remove spaces)

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (for image uploads)
# Sign up at https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Modal AI Service Configuration (for RAG/LLM)
# Successfully deployed Modal AI service endpoints ✅
MODAL_EMBEDDING_URL=https://sanudasandipa29--marketmatic-rag-embed.modal.run
MODAL_CHAT_URL=https://sanudasandipa29--marketmatic-rag-chat.modal.run

